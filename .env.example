# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard (/admin) - use a long random password and a long random secret
ADMIN_PASSWORD=change-me-please
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Where inquiries / reviews / likes are stored (JSON files). Use a persistent disk in production.
DATA_DIR=./data

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
